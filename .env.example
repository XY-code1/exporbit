# Exporbit environment template
# Copy to .env for local use. Never commit real credentials.

VITE_APP_MODE=demo
VITE_ZHIHU_PROVIDER_ENABLED=false
VITE_API_BASE_URL=http://localhost:8010/api/v1

# Server-side only placeholders for future approved integrations.
# Never expose these values in frontend code.
DEEPSEEK_API_KEY=
DATABASE_URL=postgresql+psycopg://exporbit:CHANGE_ME@localhost:5432/exporbit
FILE_STORAGE_PATH=backend/uploads
ZHIHU_PROVIDER_API_KEY=
